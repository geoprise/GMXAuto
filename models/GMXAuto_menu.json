{
  "get": {
    "summary": "Application Manifest",
    "description": "Geoprise GM/X Auto Application Manifest.",
    "operationId": "menu_getForm",
    "parameters": [
      {
        "$ref": "#/components/parameters/csrf_id"  
      },
      {
        "$ref": "#/components/parameters/session_name" 
      },
      "oneOf": [
        {
          "$ref": "#/components/parameters/selection"  
        },
        {
          "$ref": "#/components/parameters/action" 
        },
        "allOf": [
          {
            "oneOf": [
              {
                "$ref": "#/get/responses/200/content/application~1json/schema/items/pagination/page/mnu_todo" 
              },
              {
                "$ref": "#/get/responses/200/content/application~1json/schema/items/pagination/page/wf_workitem_role" 
              },
              {
                "$ref": "#/get/responses/200/content/application~1json/schema/items/pagination/page/wf_workitem_user" 
              }
            ]		  
          },
          {
            "$ref": "#/components/parameters/page"  
          }
		],
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/get/responses/200/content/application~1json/schema/items/wf_workitem_role/case_id" 
              },
              {
                "$ref": "#/get/responses/200/content/application~1json/schema/items/wf_workitem_role/workitem_id" 
              }
            ]		  
          },
          {
            "allOf": [
              {
                "$ref": "#/get/responses/200/content/application~1json/schema/items/wf_workitem_user/case_id" 
              },
              {
                "$ref": "#/get/responses/200/content/application~1json/schema/items/wf_workitem_role/workitem_id" 
              }
            ]		  
          }
        ]
      ]	  
    ],
    "responses": {
      "200": {
        "description": "A successful response containing the Geoprise GM/X Auto Application Manifest.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "mnu_favourite",
                "mnu_dashboard",
                "mnu_todo",
                "wf_workitem_role",
                "wf_workitem_user",
                "menubar", 
                "navbar", 
                "pagination", 
                "params" 
              ],
              "items": {
                "mnu_favourite": [
                  {
                    "task_id": {
                      "type": "string",
                      "description": "the identity of the favourite task to activate",
                      "example": "mnu_todo(list2)"					  
                    },
                    "task_name": {
                      "type": "string",
                      "description": "the short name of the favourite task to activate",
                      "example": "ToDo"	
                    },
                    "is_disabled": {
                      "type": "string",
                      "description": "indicates if the favourite task is currently disabled (\"Y\"), or not (\"N\")",
                      "example": "N"	
                    },
                    "tooltip": {
                      "type": "string",
                      "description": "the full name of the favourite task to activate",
                      "example": "List ToDo by User"	
                    },
                    "user_id": {
                      "type": "string",
                      "description": "the identity of the current user (person or agent)",
                      "required": true,
                      "example": "DLEE"	
                    },
                    "sort_seq": {
                      "type": "string",
                      "description": "the sort key that determines the position of the task in the Application Manifest favourites, in ascending sequence",
                      "required": true,
                      "pattern": "^[1-9][0-9]*$",
                      "example": "2"	
                    }
                  }
                ],
                "mnu_dashboard": [
                  {
                    "canvas": {
                      "type": "string",
                      "description": "the identity of the canvas containing the chart to display on the dashboard",
                      "example": "canvas1"	
                    },
                    "task_id": {
                      "type": "string",
                      "description": "the identity of the task to activate for the chart",
                      "example": "ord_order_item_s(multi5)totals"	
                    }
                  }
                ],
                "mnu_todo": [
                  {
                    "user_id": {
                      "type": "string",
                      "description": "the identity of the current user (person or agent)",
                      "required": true,
                      "example": "DLEE"	
                    },
                    "seq_no": {
                      "type": "string",
                      "description": "the sort key that determines the position of the item in the Application Manifest to-do list, in ascending sequence",
                      "pattern": "^[1-9][0-9]*$",
                      "example": "1"	
                    },
                    "item_name": {
                      "type": "string",
                      "description": "the name of the to-do item",
                      "required": true,
                      "example": "Reconcile and close the previous month"	
                    },
                    "item_desc": {
                      "type": "string",
                      "description": "the name of the to-do item",
                      "example": "Reconcile and close the previous month..."	
                    },
                    "due_date": {
                      "type": "string",
                      "description": "the date when the to-do item is due to be completed",
                      "example": "03 Sep 2026"	
                    },
                    "is_complete": {
                      "type": "string",
                      "description": "indicates if the to-do item is currently complete (\"Y\"), or not (\"N\")",
                      "required": true,
                      "example": "N"	
                    },
                    "task_id": {
                      "type": "string",
                      "description": "the identity of the to-do task to activate",
                      "example": "srv_survey_answer_dtl(multi3)respondent"					  
                    },
                    "task_context": {
                      "type": "string",
                      "description": "the key=value pair passed down to the task for the to-do item when activated",
                      "pattern": "(\\w+)=([^&\\s]+)",
                      "example": "survey_id='9798993865600000000000000000000007342'"
                    },
                    "task_name": {
                      "type": "string",
                      "description": "the full name of the task to activate for the to-do item",
                      "example": "Take Questionnaire"	
                    },
                  }
                ],
                "wf_workitem_role": [
                  {
                    "rdcaccount_id": {
                      "type": "string",
                      "description": "the identity of the hosting account associated with the current user",
                      "required": true,
                      "example": "6482"	
                    },
                    "user_id": {
                      "type": "string",
                      "description": "the identity of the current user (person or agent)",
                      "example": "DLEE"	
                    },
                    "role_id": {
                      "type": "string",
                      "description": "the identity of the role associated with this transition (must match one of the roles assigned to the current user)",
                      "example": "FIUSER"	
                    },
                    "workflow_id": {
                      "type": "string",
                      "description": "the unique identity of the workflow process to which this transition belongs",
                      "example": "8"	
                    },
                    "case_id": {
                      "type": "string",
                      "description": "the unique identity of the workflow case associated with this transition instance (workitem)",
                      "required": true,
                      "example": "74982"	
                    },
                    "workitem_id": {
                      "type": "string",
                      "description": "the unique identity of this transition instance (workitem) within the workflow case",
                      "required": true,
                      "example": "1"	
                    },
                    "transition_id": {
                      "type": "string",
                      "description": "the unique identity of this transition within the workflow process",
                      "example": "1"	
                    },
                    "task_id": {
                      "type": "string",
                      "description": "the identity of the task triggered by this transition",
                      "example": "alert_alert_detail(multi4)b"					  
                    },
                    "transition_trigger": {
                      "type": "string",
                      "description": "the mechanism for triggering this transition; i.e., manually by a user (\"USER\"), automatically by the system (\"AUTO\"), by an external event (\"MSG\"), or after a time limit has expired (\"TIME\")",
                      "enum": [
                        "USER",
                        "AUTO",
                        "MSG",
                        "TIME"						
                      ]
                    },
                    "workitem_status": {
                      "type": "string",
                      "description": "the current status of this transition instance (workitem); i.e., enabled (\"EN\"), in progress (\"IP\"), cancelled (\"CA\"), or finished (\"FI\")",
                      "enum": [
                        "EN",
                        "IP",
                        "CA",
                        "FI"						
                      ]
                    },
                    "enabled_date": {
                      "type": "string",
                      "description": "the date and time when this transition instance (workitem) was enabled",
                      "example": "01 Sep 2026 17:00:30"					  
                    },
                    "cancelled_date": {
                      "type": "string",
                      "description": "the date and time when this transition instance (workitem) was cancelled, if any",
                      "example": "01 Sep 2026 17:04:07"					  
                    },
                    "finished_date": {
                      "type": "string",
                      "description": "the date and time when this transition instance (workitem) was finished, if any",
                      "example": "01 Sep 2026 17:04:07"					  
                    },
                    "deadline": {
                      "type": "string",
                      "description": "the date and time when this transition instance (workitem) expires, if the transition trigger is \"TIME\"",
                      "example": "01 Oct 2026 17:00:30"					  
                    },
                    "context": {
                      "type": "string",
                      "description": "the key=value pairs passed down to the task when this transition instance (workitem) is triggered",
                      "pattern": "(\\w+)=([^&\\s]+)",
                      "example": "user_id='DLEE' AND seq_no='1'"
                    },
                    "workflow_name": {
                      "type": "string",
                      "description": "the name of the workflow process to which this transition belongs",
                      "example": "Approve Supplier Invoice"
                    },
                    "case_status": {
                      "type": "string",
                      "description": "the current status of the workflow case associated with this transition instance (workitem); i.e., open (\"OP\"), closed (\"CL\"), suspended (\"SU\"), or cancelled (\"CA\")",
                      "enum": [
                        "OP",
                        "CL",
                        "SU",
                        "CA"						
                      ]
                    },
                    "transition_name": {
                      "type": "string",
                      "description": "the name of this transition",
                      "example": "Approve Invoice"
                    },
                    "task_name": {
                      "type": "string",
                      "description": "the name of the task triggered by this transition",
                      "example": "Review and Approve Documents with Electronic Signature"
                    },
                    "link_text": {
                      "type": "string",
                      "description": "the text for this transition instance (workitem) that appears on the Application Manifest",
                      "example": "Approve Invoice"
                    }
                  }
                ],
                "wf_workitem_user": [
                  {
                     "$ref": "#/get/responses/200/content/application~1json/schema/items/wf_workitem_role"
                  }
                ],
                "menubar": {
                  "$ref": "#/components/schemas/MenuBar"
                },
                "navbar": {
                  "$ref": "#/components/schemas/NavBar"
                },             
                "pagination": {
                  "page": [
                    {
                      "description": "number of rows, current page, and last page for mnu_todo",
                      "$ref": "#/components/schemas/Page"
                    },
                    {
                      "description": "number of rows, current page, and last page for wf_workitem_role",
                      "$ref": "#/components/schemas/Page"
                    },
                    {
                      "description": "number of rows, current page, and last page for wf_workitem_user",
                      "$ref": "#/components/schemas/Page"
                    }
                  ]
                },
                "infomsg": {
                  "line": {
                    "$ref": "#/components/schemas/infomsg"
                  }
                },
                "errmsg": {
                  "line": {
                    "$ref": "#/components/schemas/errmsg"
                  }
                },
                "params": {
                  "script": {
                    "$ref": "#/components/schemas/ScriptURL"                           
                  },
                  "script_short": "menu",
                  "session_name": {
                    "$ref": "#/components/parameters/session_name"                         
                  },
                  "csrf_id": {
                    "$ref": "#/components/parameters/csrf_id"                          
                  },
                  "title": "Home Page",
                  "version": "GM-X v11.3.0",
                  "language": "en",
                  "project_code": {
                    "$ref": "#/components/schemas/ProjectCode"                         
                  },
                  "image-dir": "../images/",
                  "pagination_width": {
                    "$ref": "#/components/schemas/PaginationWidth"                         
                  },
                  "scrolling_width": {
                    "$ref": "#/components/schemas/ScrollingWidth"                          
                  },
                  "logged-in-as": {
                    "$ref": "#/components/schemas/LoggedInAs"                          
                  },
                  "logged-in-as-name": {
                    "$ref": "#/components/schemas/LoggedInAsName"                          
                  },
                  "mode": "list",
                  "taskid": "menu",
                  "orderby": {
                    "type": "string",
                    "description": "the column by which wf_workitem_role and wf_workitem_user records are sorted",
                    "enum": [
                      "enabled_date"
                    ]
                  },                     
                  "order": {
                    "type": "string",
                    "description": "record sorting sequence (ascending or descending)",
                    "enum": [
                      "asc"
                    ]          
                  }                  
                }
              }                    
            }
          }
        }
      }
    }        
  },
  "post": {
    "summary": "navigation bar submission",
    "description": "Navigate to a different form.",
    "operationId": "acc_email_text(list1)_submitForm",       
    "requestBody": {
      "description": "Instructions and information needed to process the action bar or navigation bar submission",
      "required": "true",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": [
              "session_name",
              "csrf_id"
            ],
            "properties": {
              "session_name": {
                "$ref": "#/components/schemas/session_name"
              },
              "csrf_id": {
                "$ref": "#/components/schemas/csrf_id"
              },
              "NavBarTask": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "label"					
                  ],
                  "properties": {
                    "id": {
                      "type": "string",            
                      "description": "instruction to navigate to one of the tasks in the standard navigation bar",
                      "pattern": "^task@main#[A-Za-z0-9_()]{0,80}$",
                      "example": "task#main#batch_log(filepicker)"
                    },
                    "label": {
                      "type": "string",            
                      "description": "the label for the task",
                      "example": "Batch Log Files"
                    }
                  }
                }
              },
              "FavouriteTask": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "label"					
                  ],
                  "properties": {
                    "id": {
                      "type": "string",            
                      "description": "instruction to navigate to our of the favourite tasks",
                      "pattern": "^favourite@main#[A-Za-z0-9_()]{0,80}$",
                      "example": "favourite#main#mnu_todo(list2)"
                    },
                    "label": {
                      "type": "string",            
                      "description": "the label for the favourite task",
                      "example": "ToDo"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "302": {
        "description": "Found. Redirect to URL for displaying the form associated with a task activated from the standard navigation bar or favourites.",
        "headers": {
          "Location": {
            "description": "The target URL for the redirect.",
            "schema": {
              "type": "string",
              "format": "uri",
              "example": "https://api.example.com/gmx/menu/batch_log_filepicker.php"
            }
          }
        }
      }
    }        
  },
  "components": {
    "schemas": {
      "callingTask": {
        "type": "object",	
        "description": "The task from which the popup task was called",		
        "examples": {			
          "type": "object",
          "required": [
            "alert",
            "actbar",
            "menubar",
            "params"
          ],
          "items": {
            "$ref": "./GMXAuto_asset.json#/paths/finance-fa~1asset(upd1).php/get/responses/200/content/application~1json/schema/items",
            "errmsg": {
              "line": {
                "enum": [
                  "Nothing selected from popup screen."           
                ]
              }
            }
          }
        }		
      },
      "choose": {
        "type": "string",			    
        "description": "instruction to return any selection (or multiple selections, if allowed) to previous form",
        "pattern": "^CHOOSE$"
      },
      "choosenull": {
        "type": "string",			    
        "description": "instruction to return no selections to previous form",
        "pattern": "^CHOOSE NULL$"
      },
      "clear": {
        "type": "string",			    
        "description": "instruction to remove all search criteria",
        "pattern": "^CLEAR$"
      },
      "collapse": {
        "type": "string",			    
        "description": "instruction to hide all the branches and leaves of the tree",
        "pattern": "^COLLAPSE$"
      },
      "copy": {
        "type": "string",			    
        "description": "instruction to copy the values of all form fields for pasting into a different instance of the same form",
        "pattern": "^COPY$"
      },	
      "created_date": {
        "type": "string",			    
        "description": "the date and time on which the record was created",
        "example": "04 Aug 2026 02:21:56"
      },
      "created_user": {
        "type": "string",			    
        "description": "the identity of the user which created the record",
        "example": "DLEE"
      },	
      "csrf_id": {
        "type": "string",			    
        "description": "unique request verification value for Cross-Site Request Forgery (CSRF) protection",
        "minLength": 23,
        "maxLength": 23,
        "pattern": "^[0-9a-fA-F]{14}\\.[0-9]{8}$"
      },
      "delete": {
        "type": "string",			    
        "description": "instruction to delete the record in the current form from the database",
        "pattern": "^DELETE$"
      },
      "error": {
        "type": "string",			    
        "description": "error encountered during validation of data submitted for a specific form field (if any)",
        "example": "column_id cannot be blank."
      },
      "errmsg": {
        "type": "string",			    
        "description": "error encountered during validation or processing of entire form (if any)",
        "example": "This action is not allowed."
      },
      "expand": {
        "type": "string",			    
        "description": "instruction to show all the branches and leaves of the tree",
        "pattern": "^EXPAND$"
      },
      "infomsg": {
        "type": "string",			    
        "description": "short description of successful processing outcome",
        "example": "The payment amount matches the document balances - payment is complete"
      },
      "InnerData": {
        "type": "object",
        "description": "A one-indexed collection of data for inner zone of the form. Keys begin with the column name, followed by a row number suffix enclosed in square braces (\"[\" and \"]\") which must be string representations of positive integers starting at \"1\". $ref: #/components/schema/Page/properties/numrows and $ref: #/components/schema/Page/properties/lastpage define the maximum row number from the following formula: maximum = IF (numrows / lastpage > 50 then 100 ELSE IF (numrows / lastpage > 25 then 50 ELSE IF (numrows / lastpage > 10 then 25 ELSE 10)))",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,64}\\[(?:[1-9][0-9]?|100)\\]$"
        },    
        "additionalProperties": {
          "type": "string"
        },
        "example": {
          "document_reference[1]": "6654397LT9TBF5Q7F",		  
          "account_id[1]": "1.234.00",
          "debit_functional[1]": "998.72",
          "credit_functional[1]": "",
          "document_reference[2]": "6654397LT9TBF5Q7F",		  
          "account_id[2]": "2.421.02",
          "debit_functional[2]": "",
          "credit_functional[2]": "998.72"
        }
      },
      "InnerDataNoLimit": {
        "type": "object",
        "description": "A one-indexed collection of data for inner zone of the form. Keys begin with the column name, followed by a row number suffix enclosed in square braces (\"[\" and \"]\") which must be string representations of positive integers starting at \"1\".",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,64}\\[[1-9][0-9]*\\]$"
        },    
        "additionalProperties": {
          "type": "string"
        },
        "example": {
          "sort_seq[1]": "2",		  
          "output_name[1]": "Order Id",
          "sort_seq[2]": "",		  
          "output_name[2]": "",
          "sort_seq[3]": "3",		  
          "output_name[3]": "Ship Country Id"
        }
      },
      "InnerTasks": {
        "type": "object",
        "description": "A one-indexed collection of popup tasks for inner zone of the form. Keys begin with the task ID (prefixed by \"#task#inner#\"), followed by a row number suffix enclosed in square braces (\"[\" and \"]\") which must be string representations of positive integers starting at \"1\". $ref: #/components/schema/Page/properties/numrows and $ref: #/components/schema/Page/properties/lastpage define the maximum row number from the following formula: maximum = IF (numrows / lastpage > 50 then 100 ELSE IF (numrows / lastpage > 25 then 50 ELSE IF (numrows / lastpage > 10 then 25 ELSE 10)))",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,64}\\[(?:[1-9][0-9]?|100)\\]$"
        },    
        "additionalProperties": {
          "type": "string"
        },
        "example": {
          "task#inner#fgl_gl_account(popup4)[3]": "Choose GL Account"		  
        }
      },
      "Item": {
        "type": "object",
        "required": [
          "id",
          "curitem",		    
          "lastitem"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "journal_entry_status_type"
          },
          "curitem": {
            "type": "integer",
            "description": "current scrolling item",
            "format": "int32",
            "minimum": 1,
            "example": "1"	
            },		    
          "lastitem": {
            "type": "integer",
            "description": "total number of rows returned by the query",
            "format": "int32",
            "minimum": 1,
            "example": "1"	
          }
        }		    
      },
      "LoggedInAs": {
        "type": "string",
        "description": "user name and last GET request timestamp, for desktop display",
        "example": "Derek Lee [04 Aug 2026 02:21:56 GMT -07:00]"		    
      },	
      "LoggedInAsName": {
        "type": "string",
         "description": "user name without last GET request timestamp, for mobile display",
        "example": "Derek Lee"		    
      },
      "LookupOption": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "value within an option list",
            "example": {
              "": "null",
              "column_id": "Column Id"
            }
          }
        }	
      },
      "MenuBar": {
        "type": "object",
        "required": [
          "button",
          "stack"
        ],
        "properties": {
          "button": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "csrf_id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "task ID",
                  "example": "pro_product(list1)"
                },
                "csrf_id": {
                  "$ref": "#/components/schemas/csrf_id"
                },
                "active": {
                  "type": "string",
                  "description": "indicates if the menu button can currently be used to send a GET request to the GM-X server",				
                  "example": "y"
                }
              }
            }
          },
          "stack": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "task ID",				
                  "example": "business_processes"
                },
                "csrf_id": {
                  "$ref": "#/components/schemas/csrf_id"
                },
                "active": {
                  "type": "string",
                  "description": "indicates if the breadcrumb link can currently be used to send a GET request to the GM-X server",					
                  "example": "y"
                }
              }
            }
          }
        }
      },	
      "NavBar": {
          "type": "object",
          "required": [
            "button"
          ],
          "properties": {
            "button": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "context_preselect",			    
                  "tooltip"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "'task#', followed by zone ID, followed by '#', followed by task ID",
                    "example": "task#main#pro_product(upd1)"
                  },
                  "context_preselect": {
                    "type": "string",
                    "description": "indicates if an item must be selected from the list (Y) before activating the button, or not (N)",				
                    "enum": [
                      "N",
                      "Y"
                    ]
                  },
                  "tooltip": {
                    "type": "string",
                    "description": "task name",				
                    "example": "Update Product"
                  }
                }
              }
            }
          }
      },
      "order": {
        "type": "string",
        "description": "record sorting sequence (ascending or descending)",
        "enum": [
          "asc",
          "desc"					    
        ]		    
      },
      "OuterData": {
        "type": "object",
        "description": "A one-indexed collection of data for outer zone of the form. Keys prefixed by \"__outer__\", followed by the column name",
        "propertyNames": {
          "type": "string",
          "pattern": "^__outer__[a-z0-9_]{0,64}$"
        },    
        "additionalProperties": {
          "type": "string"
        },
        "example": {
          "__outer__transaction_date": "24 Aug 2026",		  
          "__outer__journal_desc": "Subsidiary expenses paid by corporate parent",
          "__outer__uom_id_statistic": ""
        }
      },	  
      "Page": {
        "type": "object",
        "required": [
          "id",
          "numrows",
          "curpage",		    
          "lastpage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "inner",
              "link",
              "main",
              "middle",
              "middle1",
              "middle2",
              "mnu_todo",
              "outer",
              "workitem_role",
              "workitem_user"
            ],
            "example": "main"
          },
          "numrows": {
            "type": "integer",
            "description": "total number of rows returned by the query",
            "format": "int32",
            "minimum": 0,
            "example": "68"			
          },
          "curpage": {
            "type": "integer",
            "description": "total number of rows returned by the query",
            "format": "int32",
            "minimum": 0,
            "example": "1"	
          },		    
          "lastpage": {
            "type": "integer",
            "description": "total number of pages returned by the query (at maximum of 10, 25, 50, or 100 rows per page)",
            "format": "int32",
            "minimum": 0,
            "example": "7"	
          }
        }		    
      },
      "PaginationWidth": {
        "type": "integer",
        "description": "defines how the pagination area is displayed; default display if zero, Google style display otherwise",
        "format": "int32",
        "minimum": 0,
        "example": "7"		    
      },
      "paste": {
        "type": "string",			    
        "description": "instruction to paste the values of all form fields copied from a different instance of the same form; required when values of form fields have been copied from a different instance",
        "pattern": "^Paste$"
      },
      "ProjectCode": {
        "type": "string",
        "description": "customisation project code for this server instance",
        "example": "gmx"			
      },
      "quicksearch": {
        "type": "string",			    
        "description": "instruction to query the records using the quicksearch criterion, and then re-display current form",
        "pattern": "^Quick Search$"
      },
      "QuicksearchOption": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "column available for quicksearch criterion",
            "example": {
              "": "null",
              "column_id": "Column Id"
            }
          }
        }	
      },
      "quicksearch_field": {
        "type": "string",			    
        "description": "column for quicksearch criterion",
        "option": [
          {
            "$ref": "#components/schemas/QuicksearchOption"
          }					  
         ]
      },
      "quicksearch_value": {
        "type": "string",			    
        "description": "quicksearch criterion",		  
        "maxLength": 20,
        "pattern": "^.{0,20}$"
      },	  
      "quitCancel": {
        "type": "string",			    
        "description": "instruction to return to previous form",
        "pattern": "^CANCEL$"
      },
      "quitClose": {
        "type": "string",			    
        "description": "instruction to return to previous form",
        "pattern": "^CLOSE$"
      },
      "rdc_selection_lock": {
        "type": "integer",
        "description": "instruction to lock selected record(s) to re-select them automatically when returning to current form",
        "format": "int32",
        "minimum": 0,
        "maximum": 1,	    
        "example": "0",
        "default": 0
      },
      "reset": {
        "type": "string",			    
        "description": "instruction to remove all search criteria, sorting, and page settings, and then re-display current form",
        "pattern": "^RESET$"
      },	  
      "revised_date": {
        "type": "string",			    
        "description": "the date and time on which the record was last updated",
        "example": "04 Aug 2026 02:21:56"
      },
      "revised_user": {
        "type": "string",			    
        "description": "the identity of the user which last updated the record",
        "example": "DLEE"
      },
      "ScriptURL": {
        "type": "string",
        "description": "concatenation of URL followed by path"
      },	    
      "ScrollingWidth": {
        "type": "integer",
        "description": "defines how the scrolling area is displayed; default display if zero, Google style display otherwise",
        "format": "int32",
        "minimum": 0,
        "example": "5"			    
      },
      "select": {
        "type": "object",
        "description": "A sparse, one-indexed collection indicating selected rows on the form. Keys do not need to be sequential but must be string representations of positive integers starting at \"1\". $ref: #/components/schema/Page/properties/numrows and $ref: #/components/schema/Page/properties/lastpage define the maximum collection size from the following formula: maximum = IF (numrows / lastpage > 50 then 100 ELSE IF (numrows / lastpage > 25 then 50 ELSE IF (numrows / lastpage > 10 then 25 ELSE 10)))",
        "propertyNames": {
          "pattern": "^[1-9][0-9]*$",
          "minimum": "1",
          "maximum": {
            "oneOf": [
              "10",		
              "25",				    
              "50",
              "100"
            ]			
          }
        },    
        "additionalProperties": {
          "type": "string",
          "enum": [
            "on"
          ]
        },
        "example": {
          "1": "on",
          "3": "on",
          "19": "on",
          "47": "on",
          "78": "on"
        }
      },
      "selectNoLimit": {
        "type": "object",
        "description": "A sparse, one-indexed collection indicating selected rows on the form. Keys do not need to be sequential but must be string representations of positive integers starting at \"1\".",
        "propertyNames": {
          "pattern": "^[1-9][0-9]*$",
          "minimum": "1"
        },    
        "additionalProperties": {
          "type": "string",
          "enum": [
            "on"
          ]
        },
        "example": {
          "1": "on",
          "3": "on",
          "19": "on",
          "47": "on",
          "78": "on"
        }
      },
      "selectOne": {
        "type": "string",
        "description": "Indicates the row selected from a popup form that allows only one row to be selected. The selected row number must be a string representation of a positive integer starting at \"1\". $ref: #/components/schema/Page/properties/numrows and $ref: #/components/schema/Page/properties/lastpage define the maximum allowable value from the following formula: maximum = IF (numrows / lastpage > 50 then 100 ELSE IF (numrows / lastpage > 25 then 50 ELSE IF (numrows / lastpage > 10 then 25 ELSE 10)))",
        "propertyNames": {
          "pattern": "^[1-9][0-9]*$",
          "minimum": "1",
          "maximum": {
            "oneOf": [
              "10",		
              "25",				    
              "50",
              "100"
            ]			
          }
        },    
        "example": [
          "1",
          "3",
          "19",
          "47",
          "78"
        ]
      },
      "session_name": {
        "type": "string",			    
        "description": "Name of session cookie set by GM-X application server after successful Internal, RADIUS, LDAP, or SSL authentication.",
        "minLength": 5,
        "maxLength": 6,
        "pattern": "^menu\\d{1,2}$"							
      },
      "submitBtn": {
        "type": "string",			    
        "description": "instruction to process the form and then return to previous form if successful, or re-display current form with error message(s) if unsuccessful",
        "pattern": "^SUBMIT$"
      },
      "submitnext": {
        "type": "string",			    
        "description": "instruction to process the form and then scroll to next form (or return to previous form if current form is the last in scrolling sequence) if successful, or re-display current form with error message(s) if unsuccessful",
        "pattern": "^SUBMIT+next$"
      },
      "submitstay": {
        "type": "string",			    
        "description": "instruction to process the form and then display a fresh copy of this form if successful, or re-display current form with error message(s) if unsuccessful",
        "pattern": "^SUBMIT+stay$"
      },
      "taskid": {
        "type": "string",			    
        "description": "Task associated with request.",
        "maxLength": 80,
        "pattern": "^[a-z_()]{1,80}$"							
      }	
    },
    "parameters": {
      "action": {
        "name": "action",
        "in": "query",
        "description": "instruction to log off, create a new session, or select/unselect all rows of the current page returned by the query (at maximum of 10, 25, 50, or 100 rows per page)",
        "schema": {
          "type": "string",
          "enum": [
	        "logout",	
	        "logout_all",
	        "newsession",		    
	        "selectall",
            "unselectall"
          ]
        }		    
      },
      "collapsed": {
        "name": "collapsed",
        "in": "query",
        "description": "unique identity of a specific tree view node to be collapsed so its branches and leaves are hidden",
        "schema": {
          "type": "string",
          "pattern": "^(.+)#\\1$"
        }		    
      },
      "csrf_id": {
        "name": "csrf_id",
        "in": "query",
        "description": "unique request verification value for Cross-Site Request Forgery (CSRF) protection; required for GET requests using different path",
        "required": true,	    
        "schema": {
          "type": "string",
          "minLength": 23,
          "maxLength": 23,
          "pattern": "^[0-9a-fA-F]{14}\\.[0-9]{8}$"
        }		    
      },
      "expand": {
        "name": "expand",
        "in": "query",
        "description": "unique identity of a specific tree view node to be expanded so its branches and leaves are visible",
        "schema": {
          "type": "string",
          "pattern": "^(.+)#\\1$"
        }		    
      },
      "item": {
        "name": "item",
        "in": "query",
        "description": "instruction to return a specific row returned by a query; required when scrolling parameter exists",
        "schema": {
          "type": "integer",
          "format": "int32",		    
          "minimum": "1",
          "maximum": {
            "$ref": "#/components/schemas/Item/properties/lastitem"	
          }
        }		    
      },	
      "page": {
        "name": "page",
        "in": "query",
        "description": "instruction to return a specific page of the rows returned by a query; required when pagination parameter exists",
        "schema": {
          "type": "integer",
          "format": "int32",		    
          "minimum": "1",
          "maximum": {
            "$ref": "#/components/schemas/Page/properties/lastpage"	
          }
        }		    
      },
      "pagesize": {
        "name": "pagesize",
        "in": "query",
        "description": "instruction to return a maximum of 10, 25, 50, or 100 rows per page",
        "schema": {
          "type": "integer",
          "format": "int32",
          "enum": [
            "10",
            "25",
            "50",			
            "100"
          ],
          "maximum": {
            "$ref": "#/components/schemas/Page/properties/numrows"				    
          }		    
        }		    
      },
      "pagination": {
        "name": "pagination",
        "in": "query",
        "description": "applicable zone for a pagination request (e.g. main, outer, inner, middle, middle1, middle2, link); required when page parameter exists",
        "schema": {
          "type": "string",			
          "enum": [
            {
              "$ref": "#/components/schemas/Page/properties/id"
            }
          ]		    
        }		    
      },
      "scrolling": {
        "name": "scrolling",
        "in": "query",
        "description": "applicable class for a scrolling request; required when scrolling parameter exists",
        "schema": {
          "type": "string",
          "maxLength": 64,		
          "enum": [
            {
              "$ref": "#/components/schemas/Item/properties/id"
            }
          ]		    
        }		    
      },
      "selection": {
        "name": "selection",
        "in": "query",
        "description": "task ID selection from menu bar",
        "schema": {
          "type": "string",
          "enum": [
            {
              "$ref": "#/components/schemas/Item/properties/taskid"
            }
          ]		    
        }		    
      },
      "session_name": {
        "name": "session_name",
        "in": "query",
        "description": "Name of session cookie set by GM-X application server after successful Internal, RADIUS, LDAP, or SSL authentication.",
        "required": true,
        "schema" : {
          "type": "string",
          "minLength": 5,
          "maxLength": 6,
          "pattern": "^menu\\d{1,2}$"
        }		    
      }, 
      "taskid": {
        "name": "taskid",
        "in": "query",
        "description": "task associated with request; required when accessing written help",
        "schema": {
          "type": "string",			
          "maxLength": 80,
          "enum": [
            {
              "$ref": "#/components/schemas/taskid"
            }
          ]		
        }		    
      }
    },
    "securitySchemes": {
      "AWSELBAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "AWSELBAuthSessionCookie-0",
        "description": "The AWS ALB authentication session cookie. If its size is greater than 4K, and less than 11K, the load balancer shards it into multiple cookies (AWSELBAuthSessionCookie-0, AWSELBAuthSessionCookie-1, etc.)."		
      },		
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": {
          "schema" : {
            "type": "string",
            "minLength": 22,
            "maxLength": 256,
            "pattern": "^menu\\d{1,2}=(?:[A-Za-z0-9]{22,128}|[0-9a-fA-F]{22,256})$"
          }		
        },
        "description": "The PHP session cookie set by GM-X application server after successful Internal, RADIUS, LDAP, or SSL authentication."
      }
    }	
  },
  "security": [
    "AWSELBAuth": {
      "$ref": "#/components/securitySchemes/AWSELBAuth"
    },	  
    "sessionAuth": {
      "$ref": "#/components/securitySchemes/sessionAuth"
    },
    "antiCSRFToken": {
      "$ref": "#/components/parameters/csrf_id"
    }	
  ]  
}
